# Copia este archivo como .env y completa únicamente MONGO_URI para empezar.
# En Atlas: Connect > Drivers > Python. Conserva tu contraseña fuera de GitHub.
MONGO_URI=

# Nombre utilizado por los notebooks del segundo corte.
MONGO_DB=proyecto_segundo_corte

# Vacío: busca una colección conocida del segundo corte que tenga registros.
# Puedes fijar un nombre concreto si quieres elegir una colección específica.
MONGO_COLLECTION=

# Dirección de la API utilizada por el dashboard.
# Para desplegar, sustituye localhost por la URL HTTPS pública del backend.
API_BASE_URL=http://localhost:8000

# Extra de IA: la clave se crea en https://aistudio.google.com/apikey.
# Se configura únicamente en el backend (Render o este .env local).
# Sin clave, el catálogo y el formulario de registros siguen funcionando.
GEMINI_API_KEY=
MODELO_IA=gemini-3.6-flash
